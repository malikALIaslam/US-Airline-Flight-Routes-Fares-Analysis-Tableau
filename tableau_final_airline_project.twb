      <aliases enabled='yes' />
      <column caption='Route' datatype='string' name='[Calculation_1154255544143873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[city1] + &quot; → &quot; + [city2]' />
      </column>
      <column caption='Average Fare' datatype='real' name='[Calculation_1154255544643586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([fare])' />
      </column>
      <column caption='Total Passengers' datatype='integer' name='[Calculation_1154255544811523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([passengers])' />
      </column>
      <column caption='AVG Distance' datatype='real' name='[Calculation_1154255544913924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([nsmiles])' />
      </column>
      <column caption='Fare Differnce' datatype='real' name='[Calculation_1154255545077765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fare_lg] - [fare_low]' />
      </column>
      <column caption='Fare Category' datatype='string' name='[Calculation_1154255545225222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fare] &lt; 100 THEN &quot;Low Fare&quot;&#13;&#10;&#13;&#10;ELSEIF [fare] &lt; 200 THEN &quot;Medium Fare&quot;&#13;&#10;&#13;&#10;ELSEIF [fare] &lt; 300 THEN &quot;High Fare&quot;&#13;&#10;&#13;&#10;ELSE &quot;Very High Fare&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Distance Category' datatype='string' name='[Calculation_1154255545380871]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nsmiles] &lt; 500 THEN &quot;Short Distance&quot;&#13;&#10;&#13;&#10;ELSEIF [nsmiles] &lt; 1000 THEN &quot;Medium Distance&quot;&#13;&#10;&#13;&#10;ELSEIF [nsmiles] &lt; 2000 THEN &quot;Long Distance&quot;&#13;&#10;&#13;&#10;ELSE &quot;Very Long Distance&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Passenger Category' datatype='string' name='[Calculation_1154255545442312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [passengers] &lt; 50000 THEN &quot;Low&quot;&#13;&#10;&#13;&#10;ELSEIF [passengers] &lt; 200000 THEN &quot;Medium&quot;&#13;&#10;&#13;&#10;ELSEIF [passengers] &lt; 500000 THEN &quot;High&quot;&#13;&#10;&#13;&#10;ELSE &quot;Very High&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Total routes' datatype='integer' name='[Calculation_1154255545585673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1154255544143873])' />
      </column>
      <column caption='Year Quarter' datatype='string' name='[Calculation_1154255545724938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Year]) + &quot; Q&quot; + STR([quarter])' />
      </column>
